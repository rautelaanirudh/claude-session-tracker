{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/bin/cc-session-track\" || true", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/bin/cc-session-track\" || true", "timeout": 5 } ] }
    ]
  }
}
