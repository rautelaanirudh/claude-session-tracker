#!/usr/bin/env python3
"""SessionStart / SessionEnd hook: keep one record per session in ~/.claude/session-tracker/.

A record with no clean end, whose claude process is gone, is a session that a
reboot, crash or closed terminal cut off. cc-sessions reads these records.
Runs on macOS and Linux; does nothing elsewhere. Never fails the session.
"""
import json, os, re, subprocess, sys, time
from pathlib import Path

CONFIG = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
STATE = CONFIG / "session-tracker"
SESSION_ID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
KEEP_DAYS = 14


def process_info(pid):
    """(parent pid, argv) of a process, or None."""
    out = subprocess.run(["ps", "-o", "ppid=", "-o", "args=", "-p", str(pid)],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                         universal_newlines=True).stdout.strip()
    if not out:
        return None
    ppid, _, args = out.partition(" ")
    return int(ppid), args.split()


def claude_process():
    """Walk up from this hook to the claude process that ran it: (pid, argv) or (None, [])."""
    pid = os.getppid()
    for _ in range(6):
        info = process_info(pid)
        if not info:
            break
        ppid, argv = info
        if argv and os.path.basename(argv[0]) == "claude":
            return pid, argv
        pid = ppid
    return None, []


def prune():
    cutoff = time.time() - KEEP_DAYS * 86400
    for f in STATE.glob("*.json"):
        if f.stat().st_mtime < cutoff:
            f.unlink()


def on_start(event, path):
    pid, argv = claude_process()
    if "-p" in argv or "--print" in argv:  # headless runs end with reason 'other'; never worth resuming
        return
    record = {
        "session_id": event["session_id"],
        "cwd": event.get("cwd") or os.getcwd(),
        "pid": pid,
        "started": time.time(),
        "source": event.get("source"),
    }
    path.write_text(json.dumps(record))
    prune()


def on_end(event, path):
    if not path.exists():
        return
    record = json.loads(path.read_text())
    record["ended"] = time.time()
    record["end_reason"] = event.get("reason")
    path.write_text(json.dumps(record))


def main():
    if sys.platform not in ("darwin", "linux"):
        return
    event = json.load(sys.stdin)
    sid = event.get("session_id")
    if not isinstance(sid, str) or not SESSION_ID.match(sid):
        return
    STATE.mkdir(parents=True, exist_ok=True)
    path = STATE / f"{sid}.json"
    name = event.get("hook_event_name")
    if name == "SessionStart":
        on_start(event, path)
    elif name == "SessionEnd":
        on_end(event, path)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # never break a session over bookkeeping
        print(f"session-tracker: {exc}", file=sys.stderr)
